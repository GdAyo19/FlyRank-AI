# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Postgres server credentials (used by both the db container and the app).
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tasks

# How the app reaches the database.
#  - Locally (app on your machine, Postgres in Docker):
#      DATABASE_URL=postgresql://taskapp:changeme@localhost:5432/tasks
#  - Inside docker-compose (app + db on the same network):
#      DATABASE_URL=postgresql://taskapp:changeme@db:5432/tasks
#  - Fallback that needs no database server at all:
#      DATABASE_URL=sqlite:///tasks.db
DATABASE_URL=postgresql://taskapp:changeme@localhost:5432/tasks
